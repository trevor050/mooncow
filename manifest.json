{
  "manifest_version": 3,
  "name": "MoonCow",
  "version": "0.2.0",
  "description": "A keyboard-first command palette: smart ranking, instant answers, and a tool-using AI chat on free tiers.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open MoonCow (Ctrl+E)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Open or close the MoonCow palette"
    }
  },
  "omnibox": {
    "keyword": "mc"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "history",
    "bookmarks",
    "clipboardWrite",
    "clipboardRead",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://api.cerebras.ai/*",
    "https://www.google.com/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://en.wikipedia.org/*",
    "https://api.duckduckgo.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://wttr.in/*",
    "https://api.frankfurter.dev/*",
    "https://hn.algolia.com/*",
    "https://api.stackexchange.com/*",
    "https://r.jina.ai/*",
    "https://s.jina.ai/*",
    "https://news.google.com/*",
    "https://www.bing.com/*",
    "https://api.gdeltproject.org/*",
    "https://www.war.gov/*",
    "https://apnews.com/*",
    "https://www.theguardian.com/*",
    "https://www.reuters.com/*",
    "https://rss.cnn.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://feeds.foxnews.com/*",
    "https://www.aljazeera.com/*",
    "https://rss.politico.com/*",
    "https://thehill.com/*",
    "https://www.defenseone.com/*",
    "https://breakingdefense.com/*",
    "https://www.militarytimes.com/*",
    "https://archive.org/*",
    "https://web.archive.org/*",
    "https://www.state.gov/*",
    "https://www.whitehouse.gov/*",
    "https://home.treasury.gov/*",
    "https://www.justice.gov/*",
    "https://www.dhs.gov/*",
    "https://crsreports.congress.gov/*",
    "https://www.congress.gov/*",
    "https://www.sec.gov/*",
    "https://spaceforce.mil/*",
    "https://export.arxiv.org/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://www.biorxiv.org/*",
    "https://www.reddit.com/*",
    "https://nominatim.openstreetmap.org/*",
    "https://www.courtlistener.com/*",
    "https://www.federalregister.gov/*",
    "https://www.scotusblog.com/*"
  ],
  "background": {
    "scripts": ["src/background/index.js"],
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shared/browser-shim.js", "src/content/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/*", "src/lib/*", "src/shared/*", "vendor/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mooncow-search@mooncow.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["searchTerms", "websiteContent"]
      }
    }
  }
}
