{
  "name": "mooncow",
  "version": "0.2.0",
  "private": true,
  "description": "A keyboard-first command palette for Firefox, Zen and Chrome, built from plugins: instant answers, smart ranking, and an AI chat that runs on your own OpenAI-compatible key.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && web-ext lint --source-dir .output/firefox-mv3 --self-hosted",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && node e2e/firefox-smoke.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "nerdamer": "^2.0.1",
    "qrcode-generator": "^2.0.4"
  }
}
