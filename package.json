{
  "name": "mooncow",
  "version": "0.2.0",
  "private": true,
  "description": "A keyboard-first command palette for Firefox and Zen: smart ranking, quick answers, and a tool-using AI chat that runs on free tiers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "web-ext run --source-dir . --firefox-profile-create-if-missing",
    "lint": "eslint . && web-ext lint --source-dir . --self-hosted",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "web-ext build --source-dir . --overwrite-dest",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "nerdamer": "^2.0.1"
  }
}
